# Environment files
.env
.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

# Dependencies
node_modules/
frontend/node_modules/
backend/vendor/

# Nuxt build and cache output
frontend/.nuxt/
frontend/.output/
frontend/node_modules/.cache/

# Laravel generated files
backend/bootstrap/cache/*.php
backend/storage/*.key
backend/storage/app/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/database/database.sqlite
backend/database/database.sqlite-*

# Keep Laravel storage folder structure
!backend/storage/app/.gitignore
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/testing/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore

# Test and tool output
.phpunit.cache/
backend/.phpunit.cache/
backend/.phpunit.result.cache
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
.idea/
.vscode/
.fleet/
